{
  "name": "music-galaxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-lyrics-runtime.mjs",
    "prebuild": "node scripts/prepare-lyrics-runtime.mjs",
    "setup:lyrics": "node scripts/prepare-lyrics.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.json *.ts README.md docs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.4",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "postprocessing": "^6.37.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.180.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.12"
  }
}
